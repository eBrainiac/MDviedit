{
  "name": "mdviedit",
  "version": "1.0.0",
  "description": "MDviedit — editor y visor de Markdown de escritorio",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "sync-config": "tsx scripts/sync-config.ts",
    "predev": "pnpm sync-config",
    "prebuild": "pnpm sync-config",
    "lint": "eslint . && stylelint \"src/**/*.{css,svelte}\"",
    "test": "vitest run",
    "measure:bundle": "pnpm build && tsx scripts/measure-bundle.ts",
    "measure:ram-fixtures": "tsx scripts/generate-ram-fixtures.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.39.0",
    "@milkdown/core": "^7.22.1",
    "@milkdown/ctx": "^7.22.1",
    "@milkdown/plugin-clipboard": "^7.22.1",
    "@milkdown/plugin-cursor": "^7.22.1",
    "@milkdown/plugin-history": "^7.22.1",
    "@milkdown/plugin-listener": "^7.22.1",
    "@milkdown/preset-commonmark": "^7.22.1",
    "@milkdown/preset-gfm": "^7.22.1",
    "@milkdown/prose": "^7.22.1",
    "@milkdown/transformer": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "dompurify": "^3.4.14",
    "remark-frontmatter": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.8.1",
    "tsx": "^4.23.13",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
