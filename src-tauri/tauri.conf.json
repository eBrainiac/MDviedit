{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDviedit",
  "version": "1.0.0",
  "identifier": "mx.mdviedit.app",
  "build": {
    "beforeDevCommand": "pnpm sync-config && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sync-config && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "MDviedit",
        "width": 640,
        "height": 400,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "txt"
        ],
        "name": "Markdown",
        "description": "Documento Markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [],
        "name": "Carpeta",
        "contentTypes": [
          "public.folder"
        ],
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SpanishInternational"
        ],
        "template": "installer/mdviedit-installer.nsi",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "cli": {
      "description": "MDviedit — editor y visor de Markdown de escritorio",
      "args": [
        {
          "name": "new",
          "description": "Crea una pestaña nueva vacía"
        },
        {
          "name": "paths",
          "index": 1,
          "takesValue": true,
          "multiple": true,
          "description": "Archivos .md/.markdown/.txt o una carpeta a abrir"
        }
      ]
    }
  }
}
