{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-declaration-strict-value"],
  "overrides": [
    {
      "files": ["**/*.svelte"],
      "customSyntax": "postcss-html",
      "rules": {
        "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["global"] }]
      }
    },
    {
      "files": ["src/config/tokens.css", "src/config/palettes/*.css"],
      "rules": {
        "scale-unlimited/declaration-strict-value": null
      }
    }
  ],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "background",
        "border-color",
        "outline-color",
        "box-shadow",
        "fill",
        "stroke",
        "width",
        "height",
        "min-width",
        "min-height",
        "max-width",
        "max-height",
        "font-size",
        "font-family",
        "line-height",
        "padding",
        "padding-top",
        "padding-right",
        "padding-bottom",
        "padding-left",
        "margin",
        "margin-top",
        "margin-right",
        "margin-bottom",
        "margin-left",
        "gap",
        "border-radius",
        "border-width",
        "outline",
        "outline-offset",
        "transition-duration",
        "animation-duration"
      ],
      {
        "ignoreValues": [
          "transparent",
          "inherit",
          "initial",
          "unset",
          "currentColor",
          "none",
          "auto",
          "0",
          "100%",
          "100vh",
          "contents",
          "flex",
          "block",
          "grid",
          "center",
          "system-ui"
        ],
        "disableFix": true
      }
    ],
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "declaration-block-no-redundant-longhand-properties": [
      true,
      {
        "ignoreShorthands": ["grid-template"]
      }
    ]
  }
}
